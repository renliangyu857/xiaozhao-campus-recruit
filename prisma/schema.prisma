generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                  BigInt    @id @default(autoincrement())
  openId              String    @unique @map("open_id") @db.VarChar(64)
  unionId             String?   @map("union_id") @db.VarChar(64)
  nickname            String?   @db.VarChar(64)
  avatar              String?   @db.VarChar(512)
  queryCount          Int       @default(0) @map("query_count")
  queryCountResetAt   DateTime? @map("query_count_reset_at") @db.Date
  bonusQueries        Int       @default(0) @map("bonus_queries")
  isSubscribed        Boolean   @default(false) @map("is_subscribed")
  subscribedAt        DateTime? @map("subscribed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("app_user")
}

model Job {
  id               BigInt   @id @default(autoincrement())
  announcementId   BigInt?  @unique @map("announcement_id")
  sourceKey        String?  @map("source_key") @db.VarChar(128)
  company          String  @db.VarChar(128)
  industry         String  @db.VarChar(32)
  recruitType      String  @map("recruit_type") @db.VarChar(32)
  locations        String? @db.VarChar(512)
  startDate        String? @map("start_date") @db.VarChar(32)
  endDate          String? @map("end_date") @db.VarChar(32)
  noWrittenTest    String  @default("false") @map("no_written_test") @db.VarChar(16)
  roles            String? @db.VarChar(512)
  announcementLink String? @map("announcement_link") @db.VarChar(512)
  applyLink        String? @map("apply_link") @db.VarChar(512)
  remark           String? @db.VarChar(1024)
  batch            String? @db.VarChar(8)
  salary           String? @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([industry])
  @@index([recruitType])
  @@index([endDate])
  @@index([createdAt])
  @@index([industry, recruitType, createdAt(sort: Desc)])
  @@map("job")
}

model UserJobStatus {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  jobId     BigInt   @map("job_id")
  status    String   @db.VarChar(32)
  note      String?  @db.VarChar(1024)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("user_job_status")
}

model UserMember {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  planId    String   @map("plan_id") @db.VarChar(32)
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_member")
}

model UserInvitation {
  id           BigInt   @id @default(autoincrement())
  inviterId    BigInt   @map("inviter_id")
  inviteeId    BigInt?  @map("invitee_id")
  inviteCode   String   @unique @map("invite_code") @db.VarChar(64)
  rewardStatus String   @default("pending") @map("reward_status") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([inviterId])
  @@index([inviteeId])
  @@map("user_invitation")
}

model ReferralCode {
  id            BigInt   @id @default(autoincrement())
  companyName   String   @map("company_name") @db.VarChar(128)
  code          String   @db.VarChar(1024)
  contributorId BigInt?  @map("contributor_id")
  usageCount    Int      @default(0) @map("usage_count")
  isValid       Boolean  @default(true) @map("is_valid")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([companyName])
  @@index([isValid])
  @@map("referral_code")
}

model PanMaterialPurchase {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  materialId    String    @map("material_id") @db.VarChar(64)
  materialName  String    @map("material_name") @db.VarChar(256)
  price         Decimal   @db.Decimal(10, 2) @default(6.60)
  orderNo       String?   @unique @map("order_no") @db.VarChar(64)
  payStatus     String    @map("pay_status") @db.VarChar(32) @default("pending")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
  @@index([payStatus])
  @@map("pan_material_purchase")
}

// 订单表 - 统一管理VIP会员和资料购买订单
model Order {
  id            BigInt    @id @default(autoincrement())
  orderNo       String    @unique @map("order_no") @db.VarChar(64)
  userId        BigInt    @map("user_id")

  // 商品信息
  productType   String    @map("product_type") @db.VarChar(32)
  productId     String    @map("product_id") @db.VarChar(32)
  productName   String    @map("product_name") @db.VarChar(128)
  amount        Int       @map("amount")
  originalAmount Int?     @map("original_amount")

  // 支付信息
  payStatus     String    @map("pay_status") @db.VarChar(32) @default("pending")
  payMethod     String?   @map("pay_method") @db.VarChar(32)
  payTime       DateTime? @map("pay_time")

  // 微信支付信息（Native支付特有）
  wxCodeUrl     String?   @map("wx_code_url") @db.VarChar(512)
  wxTransactionId String? @map("wx_transaction_id") @db.VarChar(64)

  // 业务处理状态
  bizStatus     String    @map("biz_status") @db.VarChar(32) @default("pending")
  bizResult     Json?     @map("biz_result")

  // 有效期（用于VIP订单）
  validStartAt  DateTime? @map("valid_start_at")
  validEndAt    DateTime? @map("valid_end_at")

  // 客户端信息
  clientIp      String?   @map("client_ip") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)

  // 回调记录
  notifyCount   Int       @default(0) @map("notify_count")
  lastNotifyAt  DateTime? @map("last_notify_at")
  notifyResult  String?   @map("notify_result") @db.Text

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderNo])
  @@index([payStatus])
  @@index([productType, productId])
  @@index([createdAt])
  @@map("order")
}
