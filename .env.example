# ==========================================
# 数据库配置（Supabase）
# ==========================================
# 从 Supabase Dashboard → Settings → Database → Connection string 获取
# 示例: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==========================================
# Session 密钥
# ==========================================
# 【生产必填】随机字符串，至少 32 个字符，禁止使用默认值
# 生成命令: openssl rand -base64 32
SESSION_SECRET="your-session-secret-at-least-32-chars"

# ==========================================
# Redis 配置（Upstash）
# ==========================================
# 从 Upstash Console → Redis → Connect 获取
# 格式: rediss://default:<password>@<host>:6379
# 可选，如果不设置则降级为进程内内存缓存
UPSTASH_REDIS_URL=""

# ==========================================
# 应用配置
# ==========================================
# 开发环境
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 免费用户每日查询次数
MAX_FREE_QUERIES="3"

# ==========================================
# 生产环境 CORS（可选）
# ==========================================
# 生产环境 API 允许的源，多个用逗号分隔；不设则允许 *（仅开发建议）
# 示例: https://yourdomain.com
# ALLOWED_ORIGINS="https://yourdomain.com"

# ==========================================
# Vercel 部署配置（可选）
# ==========================================
# 生产上线清单详见 docs/生产上线清单.md
# 以下由 Vercel 自动注入，本地开发不需要配置
# VERCEL_URL=""
# VERCEL_ENV=""
# VERCEL_REGION=""

# ==========================================
# Sentry 错误监控配置（推荐）
# ==========================================
# 从 Sentry 控制台 → Settings → Projects → 你的项目 → Client Keys (DSN) 获取
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Sentry 组织信息（用于上传 source map）
# 从 Sentry 控制台 → Settings → Account → General Settings 获取
SENTRY_ORG="your-org-name"

# Sentry 项目名称
SENTRY_PROJECT="your-project-name"

# Sentry Auth Token（用于 CI/CD 上传 source map）
# 从 Sentry 控制台 → Settings → Account → API → Auth Tokens 创建
SENTRY_AUTH_TOKEN="sntrys_xxx"

# ==========================================
# 可选：分析工具配置
# ==========================================
# Vercel Analytics ID（自动注入）
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ==========================================
# 可选：EdgeOne / CDN 配置
# ==========================================
# 如果使用 EdgeOne 或其他 CDN，可配置缓存相关
# CDN_CACHE_KEY=""

# ==========================================
# 微信公众号登录配置（公众号验证码登录）
# ==========================================
# 登录流程：用户关注公众号 → 发送「登录」→ 后台被动回复 6 位验证码 → 网页输入登录
# WECHAT_MP_TOKEN：公众号后台「消息推送配置」中的 Token（需与后台填写一致），用于消息验签
# 启用消息推送后，公众号自带的自动回复/自定义菜单会失效
# 说明：验证码登录走「被动回复」，全程不调用微信 API，无需 AppID/Secret 与 IP 白名单
WECHAT_MP_TOKEN="your_mp_token_here"
WECHAT_APP_ID="wxYOUR_APP_ID_HERE"
WECHAT_APP_SECRET="YOUR_APP_SECRET_HERE"

# ==========================================
# 易支付 ezfp 支付网关配置（V2 / SHA256WithRSA）
# 文档: https://www.ezfp.cn/doc/index.html
# 商户后台 → 个人资料 → API信息 获取：商户 PID、商户私钥、平台公钥
# ⚠️ 私钥/公钥为敏感凭据，切勿提交进仓库；本地放 .env，生产放 Vercel 环境变量
# ==========================================
# 商户 PID（数字字符串）
EZFP_PID=""
# 商户私钥 PEM（允许以 \n 转义，也支持纯 base64 自动补全头）
EZFP_PRIVATE_KEY=""
# 平台公钥 PEM（回调验签用）
EZFP_PUBLIC_KEY=""
# 网关基础地址（默认 https://www.ezfp.cn，如有差异在 Vercel 覆盖）
EZFP_API_URL="https://www.ezfp.cn"

# ==========================================
# 支付宝官方 v3 配置（PC 网站支付 / alipay.trade.page.pay）
# 文档: https://opendocs.alipay.com/open/270/105899
# ⚠️ 私钥/公钥为敏感凭据，切勿提交进仓库；本地放 .env，生产放 Vercel 环境变量
# ==========================================
# APP_ID（16 位数字）
ALIPAY_APP_ID=""
# 应用私钥 PEM（推荐 PKCS8 / RSA2）。允许 \n 转义或纯 base64 自动补头
ALIPAY_APP_PRIVATE_KEY=""
# 支付宝公钥 PEM（异步通知验签用，从开发者中心「应用信息 → 应用公钥 → 上传应用公钥后获得」）
ALIPAY_PUBLIC_KEY=""
# 网关：生产 https://openapi.alipay.com/gateway.do / 沙箱 https://openapi.alipaydev.com/gateway.do
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# 异步回调地址（不填则默认 ${NEXT_PUBLIC_APP_URL}/api/payment/notify）
ALIPAY_NOTIFY_URL=""
# 同步回调地址（不填则默认 ${NEXT_PUBLIC_APP_URL}/vip?paid=1）
ALIPAY_RETURN_URL=""
# 选择支付通道：ezfp（中间聚合）或 alipay（支付宝官方）
PAYMENT_PROVID="ezfp"

# ==========================================
# 定时爬虫凭据（GitHub Actions Secrets，非本地 .env）
# ==========================================
# 以下两项在 GitHub Repo → Settings → Secrets and variables → Actions 中配置，
# 由 .github/workflows/crawl-jobs.yml 在 job 级 env 注入，crawler 通过 process.env 读取。
# 本地开发若想手动跑 npm run crawl:jobs，可临时在 .env.local 里设同名变量。

# 1) paperball-edu 登录后的完整 Cookie（爬虫数据源鉴权用）
#    - 值：浏览器登录 https://web.paperball-edu.com 后，从 DevTools → Network/Application 复制的 Cookie 请求头完整字符串
#    - 约 30 天过期；过期后 GitHub Actions 标红 + 飞书告警，需重新导出覆盖此 Secret
#    - ⚠️ 切勿把 Cookie 提交进仓库或粘贴到聊天/工单
PAPERBALL_COOKIE=""

# 2) 飞书自定义机器人 Webhook（爬虫失败告警，可选）
#    - 值：飞书群 → 群设置 → 群机器人 → 添加「自定义机器人」后复制的 Webhook 地址
#          形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx-xxxx
#    - ⚠️ 创建机器人时「安全设置」不要勾选签名校验（当前 crawler 未实现签名，勾了消息会被拒收）
#    - 不填则失败时不发飞书消息，但 GitHub Actions 失败本身仍有默认通知
FEISHU_WEBHOOK_URL=""
