{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "dotenv -e .env.local -- prisma generate && dotenv -e .env.local -- next build",
    "build:prod": "dotenv -e .env.production -- prisma generate && dotenv -e .env.production -- next build",
    "start": "next start",
    "lint": "eslint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --project=chromium",
    "e2e:api": "playwright test --config=playwright.api.config.ts",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "postinstall": "prisma generate",
    "xhs:generate": "dotenv -e .env.local -- node scripts/daily-xhs-generator.js",
    "xhs:schedule": "dotenv -e .env.local -- node scripts/scheduled-runner.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.2",
    "@sentry/nextjs": "^9.3.0",
    "@upstash/redis": "^1.36.3",
    "framer-motion": "^12.34.5",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.575.0",
    "next": "^15.2.0",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-pdf": "^10.4.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.34",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
